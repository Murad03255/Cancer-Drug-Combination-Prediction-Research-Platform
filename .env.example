# ==============================================================================
# Cancer Drug Combination Prediction & Research Platform
# Environment Variables Configuration
# ==============================================================================

# Application Meta
APP_NAME="Cancer Drug Combination Prediction & Research Platform"
APP_VERSION="1.0.0"
DEBUG=True

# Backend Security
SECRET_KEY="cancer-prediction-platform-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Default is SQLite, or PostgreSQL e.g. postgresql://user:pass@localhost:5432/cancer_prediction)
DATABASE_URL="sqlite:////app/backend/data/cancer_prediction.db"

# ML Model Paths (configured automatically inside Docker)
MODEL_DIR="/app/ml/saved_models"
MODELS_OUT_DIR="/app/models_out"

# Frontend Configuration
VITE_API_URL="http://localhost:8000"
